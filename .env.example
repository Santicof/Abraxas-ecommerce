# Copiá este archivo como .env.local y completá los valores.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor: nunca la expongas con prefijo NEXT_PUBLIC_ (empieza con sb_secret_)
SUPABASE_SECRET_KEY=

# Mercado Pago (Tus integraciones → Credenciales). Usá las de prueba en desarrollo.
MP_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks
MP_WEBHOOK_SECRET=

# URL pública del sitio (sin barra final). En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ingreso simple al panel con usuario y clave fijos (opcional). Entra como la cuenta de PANEL_EMAIL.
# Dejalas vacías para desactivarlo. Usá una clave larga y cambiala si la compartís.
PANEL_USUARIO=
PANEL_CLAVE=
PANEL_EMAIL=
# Enlace de acceso directo sin escribir nada: /admin/entrar?k=<PANEL_ENLACE>. Mínimo 20 caracteres aleatorios.
PANEL_ENLACE=
